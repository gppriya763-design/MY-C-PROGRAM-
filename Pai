#include <stdio.h>
#include<math.h>
#define PI 3.14
int main() {
    float x,sum,term,nume;
    int deg;
    i=2,fact=1;
    printf ("angle in degree");
    scanf("%d",&deg);
    x=(deg*PI)/180;
    sum=x;
    nume=x;
    do
    {
        fact=fact*i*(i+1);
        nume=nume*x*x;
        term=nume/fact;
        sum+=term;
        i+=2;
    }while(fabs(term)>0.0001);
    printf ("approximated sin(%d)=%.2f",deg,sum);
    
    

    return 0;
}
