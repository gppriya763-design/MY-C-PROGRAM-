#include <stdio.h>
int main() {
    int day;
    printf ("enter the value (1-3)");
    scanf("%d",& day);
    switch (day){
        case 1:
        printf ("monday\n");
        break;
        case 2:
        printf ("Tuesday\n");
        break;
        case 3:
        printf ("Wednesday\n");
       default:
        printf ("invalid number\n");
    return 0;
}
}
