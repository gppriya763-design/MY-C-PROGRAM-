
#include <stdio.h>
#include <stdlib.h>
int main() {
    int *p,n=5;
    p =(int*)calloc(5,sizeof(int));
    if (p == NULL) {
    
        printf ("memory not allocated!\n");
        return 0;
    }
    printf ("value after colloc\n");
    for(int i=0;i<n;i++){
        printf ("%d",p[i]);
        free(p);
        return 0;
    }
}
