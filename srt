// Online C compiler to run C program online
#include <stdio.h>
int sicaluculator(){
    int p,t,r,si;
    printf ("enter the principal amount\n");
    scanf("%d",&p);
    printf ("enter the year\n");
    scanf("%d",&t);
    printf("enter the rate of interest\n");
    scanf("%d,&r");
    si=(p*t*r)/100;
    printf ("the simple interest:%d,si");
}
int main() {
    sicaluculator();
}
    
    
    
    


