#include <stdio.h>
#include <math.h>
int main() {
    float X1,X2,Y1,Y2,distance;
    printf("enter X1 and Y1");
    scanf("%f%f",&X1,&Y1);
    printf("enter X2 and Y2");
    scanf("%f%f",&X2,&Y2);
    distance=sqrt((X2-X1)*(X2-X1)+(Y2-Y1)*(Y2-Y1));
    printf("The stright line distance between two points is:%2f\n",distance);
 
 
}
